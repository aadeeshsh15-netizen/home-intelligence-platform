#ifndef CONFIG_H
#define CONFIG_H

// =============================================================================
// Home Intelligence Platform - Physical ESP32 Node Configuration Template
// Copy this file to "config.h" and insert your credentials.
// =============================================================================

// 1. Wi-Fi Connectivity
#define WIFI_SSID         "Your_WiFi_Network"
#define WIFI_PASSWORD     "Your_WiFi_Password"

// 2. MQTT Broker
#define MQTT_BROKER_HOST  "192.168.1.100" // IP of machine running Home Intelligence Platform or Mosquitto
#define MQTT_BROKER_PORT  1883

// 3. Device Identity & Security (Obtained from /devices in Web UI)
#define HOME_ID           "YOUR_HOME_CUID"
#define DEVICE_ID         "esp32-living-room-01"
#define DEVICE_SECRET     "dvt_live_your_device_token"

// 4. Topic Hierarchy
#define TOPIC_TELEMETRY   "home/" HOME_ID "/device/" DEVICE_ID "/telemetry"
#define TOPIC_STATUS      "home/" HOME_ID "/device/" DEVICE_ID "/status"
#define TOPIC_COMMAND     "home/" HOME_ID "/device/" DEVICE_ID "/command"

// 5. Hardware Pin Assignments (ESP32 DevKit v1)
#define PIN_DHT22         4   // GPIO 4: Temperature & Humidity
#define PIN_MQ135_ADC     34  // GPIO 34 (ADC1_CH6): CO2/Air Quality Proxy
#define PIN_PIR_MOTION    18  // GPIO 18: Motion Occupancy
#define PIN_REED_CONTACT  19  // GPIO 19: Window/Door Magnetic Reed (Pulled-up)
#define PIN_STATUS_LED    2   // GPIO 2: Onboard Blue Status LED

// 6. Timing Constants (Milliseconds)
#define TELEMETRY_INTERVAL_MS 10000 // 10s sensor reporting
#define HEARTBEAT_INTERVAL_MS 30000 // 30s status ping
#define NTP_SYNC_INTERVAL_MS  3600000 // 1h clock re-sync

#endif // CONFIG_H
