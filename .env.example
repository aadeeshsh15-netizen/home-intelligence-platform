# ==============================================================================
# Home Intelligence Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust values for your environment.
# NEVER commit the actual '.env' file or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------

# Name:        NODE_ENV
# Purpose:     Specifies runtime environment ('development', 'production', 'test')
# Required:    Optional (defaults to 'development')
# Server-Only: Yes
# Secret:      No
# Safe Value:  development
NODE_ENV=development

# Name:        PORT
# Purpose:     Local TCP port binding for Next.js HTTP server
# Required:    Optional (defaults to 3000)
# Server-Only: Yes
# Secret:      No
# Safe Value:  3000
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------

# Name:        DATABASE_URL
# Purpose:     Prisma connection string to PostgreSQL database with schema parameter
# Required:    REQUIRED (must be a valid URI)
# Server-Only: Yes
# Secret:      YES (contains database credentials in production)
# Safe Value:  postgresql://postgres:postgres@localhost:5432/home_intelligence?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/home_intelligence?schema=public"

# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC SECURITY & SESSION MANAGEMENT
# ------------------------------------------------------------------------------

# Name:        APP_SECRET
# Purpose:     Primary cryptographic key for HMAC-SHA256 session token signatures
# Required:    REQUIRED in production (minimum 32 characters)
# Server-Only: Yes
# Secret:      YES (CRITICAL: compromise allows token forgery)
# Safe Value:  super-secret-dev-app-key-change-in-production-min-32-chars
APP_SECRET="super-secret-dev-app-key-change-in-production-min-32-chars"

# Name:        JWT_SECRET
# Purpose:     Secondary cryptographic secret (falls back to APP_SECRET if omitted)
# Required:    Optional (minimum 32 characters if set)
# Server-Only: Yes
# Secret:      YES
# Safe Value:  super-secret-dev-jwt-key-change-in-production-min-32-chars
JWT_SECRET="super-secret-dev-jwt-key-change-in-production-min-32-chars"

# ------------------------------------------------------------------------------
# 4. EDGE MQTT BROKER & TRANSPORT
# ------------------------------------------------------------------------------

# Name:        MQTT_BROKER_URL
# Purpose:     Full connection URI for the MQTT broker used by the MQTT gateway
# Required:    Optional (defaults to 'mqtt://localhost:1883')
# Server-Only: Yes
# Secret:      No (unless credentials embedded)
# Safe Value:  mqtt://localhost:1883
MQTT_BROKER_URL="mqtt://localhost:1883"

# Name:        MQTT_USERNAME
# Purpose:     Optional authentication username for MQTT broker
# Required:    Optional
# Server-Only: Yes
# Secret:      No
# Safe Value:  (blank in dev)
# MQTT_USERNAME=""

# Name:        MQTT_PASSWORD
# Purpose:     Optional authentication password for MQTT broker
# Required:    Optional
# Server-Only: Yes
# Secret:      YES
# Safe Value:  (blank in dev)
# MQTT_PASSWORD=""

# Name:        MQTT_BROKER_HOST
# Purpose:     Hostname or LAN IP passed to ESP32 provisioning firmware snippets
# Required:    Optional (defaults to '127.0.0.1')
# Server-Only: Yes
# Secret:      No
# Safe Value:  192.168.1.100
MQTT_BROKER_HOST="127.0.0.1"

# Name:        MQTT_BROKER_PORT
# Purpose:     Port passed to ESP32 provisioning firmware snippets
# Required:    Optional (defaults to 1883)
# Server-Only: Yes
# Secret:      No
# Safe Value:  1883
MQTT_BROKER_PORT=1883

# ------------------------------------------------------------------------------
# 5. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------

# Name:        LOG_LEVEL
# Purpose:     Logging threshold ('DEBUG', 'INFO', 'WARN', 'ERROR')
# Required:    Optional (defaults to 'INFO' in production, 'DEBUG' in development)
# Server-Only: Yes
# Secret:      No
# Safe Value:  INFO
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 6. THERMODYNAMIC SIMULATOR CONFIGURATION
# ------------------------------------------------------------------------------

# Name:        SIMULATOR_ENABLED
# Purpose:     Toggle background physics simulation loop for virtual sensors
# Required:    Optional (defaults to 'true')
# Server-Only: Yes
# Secret:      No
# Safe Value:  true
SIMULATOR_ENABLED=true

# Name:        SIMULATOR_INTERVAL_MS
# Purpose:     Interval in milliseconds between simulator physics calculation steps
# Required:    Optional (defaults to 5000, min 500, max 60000)
# Server-Only: Yes
# Secret:      No
# Safe Value:  5000
SIMULATOR_INTERVAL_MS=5000

# ------------------------------------------------------------------------------
# 7. TELEMETRY & INGESTION GUARDRAILS
# ------------------------------------------------------------------------------

# Name:        TELEMETRY_STALE_THRESHOLD_SECONDS
# Purpose:     Inactivity duration before sensor/device health is marked STALE
# Required:    Optional (defaults to 120 seconds)
# Server-Only: Yes
# Secret:      No
# Safe Value:  120
TELEMETRY_STALE_THRESHOLD_SECONDS=120

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & ABUSE CONTROLS
# ------------------------------------------------------------------------------

# Name:        RATE_LIMIT_ENABLED
# Purpose:     Enforce in-memory sliding-window rate limiting on sensitive APIs
# Required:    Optional (defaults to 'true')
# Server-Only: Yes
# Secret:      No
# Safe Value:  true
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------------------
# 9. OPTIONAL EXTERNAL MACHINE LEARNING MICROSERVICE
# ------------------------------------------------------------------------------

# Name:        PREDICTION_ML_SERVICE_URL
# Purpose:     Optional remote Python/ONNX ML endpoint with circuit-breaker fallback
# Required:    Optional
# Server-Only: Yes
# Secret:      No
# Safe Value:  (blank by default, uses in-process GBDT/Random Forest)
# PREDICTION_ML_SERVICE_URL="http://localhost:8000/predict"
