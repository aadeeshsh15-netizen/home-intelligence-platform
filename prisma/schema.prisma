datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum DeviceProtocol {
  SIMULATED
  MQTT
  ZIGBEE
  MATTER
  HTTP
}

enum DeviceStatus {
  ONLINE
  STALE
  DEGRADED
  OFFLINE
  ERROR
}

enum ProvisioningStatus {
  UNPROVISIONED
  PENDING_PAIRING
  PROVISIONED
  REVOKED
}

enum SensorType {
  TEMPERATURE    // °C
  HUMIDITY       // %
  CO2            // ppm
  PM2_5          // µg/m³
  POWER          // W
  OCCUPANCY      // 0 or 1
  LIGHT          // lux
  NOISE          // dB
  WATER_FLOW     // L/min
  CONTACT        // binary (0 closed, 1 open)
}

enum SensorHealth {
  HEALTHY
  STALE
  FAULTY
  OFFLINE
}

enum SeverityLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum EventStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum InsightType {
  ANOMALY
  EFFICIENCY
  CORRELATION
  EQUIPMENT_HEALTH
}

enum IncidentStatus {
  DETECTED
  ACTIVE
  RESOLVED
  DISMISSED
}

enum IncidentType {
  COOKING_EVENT
  WATER_LEAK
  AC_FAILURE
  WINDOW_THERMAL_EVENT
  MULTI_SENSOR_ANOMALY
}

enum PredictiveIncidentStatus {
  PREDICTED
  CONFIRMED
  EXPIRED
  DISMISSED
}

enum PredictionOutcome {
  TRUE_POSITIVE
  FALSE_POSITIVE
  UNRESOLVED
}

enum PredictiveIncidentType {
  PREDICTED_CO2_VENTILATION
  PREDICTED_AC_FAILURE
  PREDICTED_ENERGY_SURGE
  PREDICTED_THERMAL_BREACH
}


enum PredictionTarget {
  HOUSEHOLD_POWER
  ROOM_TEMPERATURE
  ROOM_CO2
  OCCUPANCY_PROBABILITY
}

enum ModelType {
  STATISTICAL_PERSISTENCE
  STATISTICAL_EMA
  STATISTICAL_SEASONAL_DECAY
  BAYESIAN_OCCUPANCY
  ML_LINEAR_REGRESSION
  ML_GRADIENT_BOOSTING
  ML_RANDOM_FOREST
  REMOTE_MICROSERVICE
}

enum AutomationMode {
  AUTO
  MANUAL
  DISABLED
}

enum AutomationStatus {
  IDLE
  TRIGGERED
  EXECUTING
  VERIFYING
  COMPLETED
  COOLDOWN
  FAILED
  OVERRIDDEN
}

enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  COMPLETED
  REJECTED
  EXPIRED
  TIMED_OUT
  FAILED
}

enum VerificationStatus {
  PENDING
  VERIFIED_EFFECTIVE
  VERIFIED_INEFFECTIVE
  INCONCLUSIVE
  FAILED
}

enum ActuatorType {
  VENTILATION_FAN
  STATUS_LED
  LOW_VOLTAGE_RELAY
  ALARM_BUZZER
  THERMOSTAT_SETPOINT
}

enum ActuatorAction {
  TURN_ON
  TURN_OFF
  SET_SPEED
  SET_LEVEL
  PULSE
  SHED_LOAD
}

enum SystemEventCategory {
  TELEMETRY
  ANOMALY
  INCIDENT
  PREDICTION
  AUTOMATION
  COMMAND
  SECURITY
  SYSTEM
}



model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(OWNER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  homes        Home[]
}

model Home {
  id          String     @id @default(cuid())
  name        String
  timezone    String     @default("UTC")
  address     String?
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  floors      Floor[]
  rules       Rule[]
  events      Event[]
  insights    Insight[]
  incidents   Incident[]
  predictiveIncidents PredictiveIncident[]
  modelEvaluations ModelEvaluation[]
  automationPolicies AutomationPolicy[]
  deviceCommands   DeviceCommand[]
  automationExecutions AutomationExecution[]
  systemEvents     SystemEvent[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Floor {
  id          String     @id @default(cuid())
  homeId      String
  home        Home       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  level       Int        // 0: Ground, 1: First Floor, -1: Basement
  name        String     // e.g. "Ground Floor", "Upper Level"
  svgLayout   Json?      // Vector/grid bounding box definition for interactive floor plan
  rooms       Room[]
  createdAt   DateTime   @default(now())
}

model Room {
  id          String     @id @default(cuid())
  floorId     String
  floor       Floor      @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name        String     // e.g. "Master Bedroom", "Kitchen", "Living Room"
  roomType    String     // "BEDROOM", "LIVING_ROOM", "KITCHEN", "OFFICE", "BATHROOM"
  targetTemp  Float?     // Target comfort temperature (°C)
  layoutX     Float      // Normalized 0-100 coordinates for floor plan
  layoutY     Float
  layoutW     Float
  layoutH     Float
  devices     Device[]
  sensors     Sensor[]
  events      Event[]
  insights    Insight[]
  incidents   Incident[]
  predictiveIncidents PredictiveIncident[]
  createdAt   DateTime   @default(now())
}

model Device {
  id                 String             @id @default(cuid())
  roomId             String
  room               Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name               String             // e.g. "Living Room AC", "ESP32 Sensor Hub"
  deviceType         String             // "HVAC", "LIGHTING", "APPLIANCE", "VENTILATION", "ENVIRONMENTAL_HUB"
  hardwareType       String?            // "ESP32_WROOM_32", "ESP8266", "SIMULATED"
  protocol           DeviceProtocol     @default(SIMULATED)
  identifier         String             @unique // MAC, Serial, or MQTT Client ID
  status             DeviceStatus       @default(ONLINE)
  provisioningStatus ProvisioningStatus @default(PROVISIONED)
  macAddress         String?
  authTokenHash      String?            // Salted hash of device pairing secret
  firmwareVersion    String?
  lastSeenAt         DateTime           @default(now())
  lastHeartbeatAt    DateTime?
  configuration      Json?              // Dynamic device settings / thresholds
  isActuator         Boolean            @default(false)
  actuatorType       ActuatorType?
  actuatorState      Json?              // e.g. { "power": "OFF", "speed": 0 }
  sensors            Sensor[]
  events             Event[]
  commands           DeviceCommand[]
  automationExecutions AutomationExecution[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Sensor {
  id                  String               @id @default(cuid())
  roomId              String
  room                Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  deviceId            String?
  device              Device?              @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  type                SensorType
  unit                String               // "°C", "%", "ppm", "W", "lux", "dB"
  samplingIntervalSec Int                  @default(30)
  minExpectedValue    Float
  maxExpectedValue    Float
  lastReadingValue    Float?
  lastReadingTime     DateTime?
  health              SensorHealth         @default(HEALTHY)
  readings            TelemetryReading[]
  baselines           TelemetryBaseline[]
  events              Event[]
  insights            Insight[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([roomId, type])
}

model TelemetryReading {
  id        BigInt   @id @default(autoincrement())
  sensorId  String
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  timestamp DateTime
  value     Float
  quality   String   @default("VALID") // "VALID", "DEGRADED", "INTERPOLATED"

  @@unique([sensorId, timestamp])
  @@index([sensorId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
}

model TelemetryBaseline {
  id          String   @id @default(cuid())
  sensorId    String
  sensor      Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0 (Sunday) to 6 (Saturday)
  hourOfDay   Int      // 0 to 23
  mean        Float
  stdDev      Float
  sampleCount Int
  updatedAt   DateTime @updatedAt

  @@unique([sensorId, dayOfWeek, hourOfDay])
}

model Rule {
  id                String        @id @default(cuid())
  homeId            String
  home              Home          @relation(fields: [homeId], references: [id], onDelete: Cascade)
  name              String
  sensorType        SensorType
  operator          String        // "GT", "LT", "RATE_OF_CHANGE", "STALE_TIMEOUT"
  threshold         Float
  durationSeconds   Int           @default(0)
  severity          SeverityLevel @default(WARNING)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
}

model Event {
  id          String        @id @default(cuid())
  homeId      String
  home        Home          @relation(fields: [homeId], references: [id], onDelete: Cascade)
  roomId      String?
  room        Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  deviceId    String?
  device      Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  sensorId    String?
  sensor      Sensor?       @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  category    String        // "ENVIRONMENTAL", "ENERGY", "CONNECTIVITY", "ANOMALY"
  severity    SeverityLevel
  title       String
  description String
  contextData Json?         // { currentValue, threshold, baselineMean, zScore }
  status      EventStatus   @default(ACTIVE)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  @@index([homeId, createdAt(sort: Desc)])
  @@index([status, severity])
}

model Insight {
  id                  String      @id @default(cuid())
  homeId              String
  home                Home        @relation(fields: [homeId], references: [id], onDelete: Cascade)
  roomId              String?
  room                Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  sensorId            String?
  sensor              Sensor?     @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  type                InsightType
  title               String
  summary             String
  explanation         String      // Explicit mathematical/heuristic derivation
  confidence          Float       // 0.00 to 1.00
  isHeuristic         Boolean     @default(false)
  evidenceData        Json        // Detailed mathematical breakdown: { baseline, current, zScore, trendSlope }
  status              String      @default("ACTIVE") // "ACTIVE", "ACKNOWLEDGED", "DISMISSED"
  createdAt           DateTime    @default(now())

  @@index([homeId, createdAt(sort: Desc)])
}

model Incident {
  id                  String         @id @default(cuid())
  homeId              String
  home                Home           @relation(fields: [homeId], references: [id], onDelete: Cascade)
  roomId              String?
  room                Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  incidentType        IncidentType
  severity            SeverityLevel  @default(WARNING)
  status              IncidentStatus @default(ACTIVE)
  title               String
  summary             String
  explanation         String         // Detailed explainable derivation of contributing sensors
  confidence          Float          // Mathematically derived from evidence weights (0.00 to 1.00)
  correlationWindowMs Int            // Temporal sliding window used (e.g. 900,000 ms)
  startedAt           DateTime       // Earliest contributing evidence timestamp
  detectedAt          DateTime       @default(now())
  resolvedAt          DateTime?
  lastEvidenceAt      DateTime       @default(now())
  evidence            Json           // ContributingSensorEvidence[]: values, baselines, deltas, weights
  auditPayload        Json?          // Audit metrics: { ruleId, distinctSensorCount, rawConfidence, corroborationFactor }
  predictiveIncident  PredictiveIncident?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([homeId, status, createdAt(sort: Desc)])
  @@index([homeId, incidentType, status])
}

model PredictiveIncident {
  id                    String                   @id @default(cuid())
  homeId                String
  home                  Home                     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  roomId                String?
  room                  Room?                    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  type                  PredictiveIncidentType
  target                PredictionTarget
  status                PredictiveIncidentStatus @default(PREDICTED)
  outcome               PredictionOutcome        @default(UNRESOLVED)
  severity              SeverityLevel            @default(WARNING)

  title                 String
  summary               String
  explanation           String

  probability           Float                    // Mathematically derived threshold-crossing probability [0.0 - 1.0]
  confidence            Float                    // Corroboration & model confidence [0.0 - 1.0]

  horizonMinutes        Int                      // Evaluation horizon (e.g. 15, 30, 60, 240)
  currentValue          Float
  predictedValue        Float
  thresholdValue        Float
  baselineValue         Float

  confidenceInterval80  Json?                    // { lower: number, upper: number }
  confidenceInterval95  Json?                    // { lower: number, upper: number }

  modelType             ModelType
  modelName             String

  expectedCrossingTime  DateTime?
  predictedLeadTimeMin  Float?

  actualCrossingTime    DateTime?
  actualLeadTimeMin     Float?

  contributingEvidence  Json                     // Contributing sensor evidence & signals

  confirmedIncidentId   String?                  @unique
  confirmedIncident     Incident?                @relation(fields: [confirmedIncidentId], references: [id], onDelete: SetNull)

  automationExecutions  AutomationExecution[]

  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  evaluatedAt           DateTime?

  @@index([homeId, status, createdAt(sort: Desc)])
  @@index([homeId, type, status])
}

model PredictionModel {
  id              String           @id @default(cuid())
  name            String
  type            ModelType
  version         String           // e.g. "1.0.0"
  target          PredictionTarget
  hyperparameters Json             // e.g. { alpha: 0.2, halfLifeMinutes: 45 }
  isActive        Boolean          @default(true)
  isDefault       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  evaluations     ModelEvaluation[]

  @@index([target, isActive])
}

model ModelEvaluation {
  id                 String           @id @default(cuid())
  modelId            String
  model              PredictionModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  homeId             String
  home               Home             @relation(fields: [homeId], references: [id], onDelete: Cascade)
  target             PredictionTarget
  evaluationWindow   String           // e.g. "7d", "14d"
  sampleCount        Int
  mae                Float
  rmse               Float
  horizonMetrics     Json             // { "15m": { mae: 0.12, rmse: 0.18 }, "1h": { ... }, "24h": { ... } }
  inferenceLatencyMs Float
  evaluatedAt        DateTime         @default(now())

  @@index([modelId, evaluatedAt(sort: Desc)])
  @@index([homeId, target, evaluatedAt(sort: Desc)])
}

model AutomationPolicy {
  id               String                 @id @default(cuid())
  homeId           String
  home             Home                   @relation(fields: [homeId], references: [id], onDelete: Cascade)
  name             String
  description      String
  mode             AutomationMode         @default(AUTO)
  triggerType      PredictiveIncidentType
  targetMetric     PredictionTarget
  minProbability   Float                  @default(0.75)
  minConfidence    Float                  @default(0.70)
  cooldownSec      Int                    @default(900)   // 15 minutes
  maxRuntimeSec    Int                    @default(1800)  // 30 minutes
  targetDeviceType String                 // e.g. "VENTILATION_FAN", "STATUS_LED"
  action           ActuatorAction         @default(TURN_ON)
  parameters       Json?                  // e.g. { speed: 2, durationSec: 1800 }
  safetyChecks     Json?                  // e.g. { requireOccupancy: true, failClosed: true }
  isEnabled        Boolean                @default(true)
  lastTriggeredAt  DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  executions       AutomationExecution[]

  @@index([homeId, isEnabled, triggerType])
}

model DeviceCommand {
  id             String                @id @default(cuid())
  homeId         String
  home           Home                  @relation(fields: [homeId], references: [id], onDelete: Cascade)
  deviceId       String
  device         Device                @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  commandId      String                @unique // Per-dispatch unique ID for idempotency & ack tracking
  action         ActuatorAction
  parameters     Json?
  expectedState  Json?
  status         CommandStatus         @default(PENDING)
  source         String                @default("AUTOMATION_ENGINE") // "AUTOMATION_ENGINE" | "MANUAL_OVERRIDE"
  issuedAt       DateTime              @default(now())
  expiresAt      DateTime
  acknowledgedAt DateTime?
  completedAt    DateTime?
  retryCount     Int                   @default(0)
  maxRetries     Int                   @default(2)
  resultPayload  Json?
  errorMessage   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  executions     AutomationExecution[]

  @@index([homeId, deviceId, status])
  @@index([commandId])
}

model AutomationExecution {
  id                   String                  @id @default(cuid())
  homeId               String
  home                 Home                    @relation(fields: [homeId], references: [id], onDelete: Cascade)
  policyId             String
  policy               AutomationPolicy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  predictiveIncidentId String?
  predictiveIncident   PredictiveIncident?     @relation(fields: [predictiveIncidentId], references: [id], onDelete: SetNull)
  deviceId             String
  device               Device                  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  commandId            String?
  command              DeviceCommand?          @relation(fields: [commandId], references: [commandId], onDelete: SetNull)
  status               AutomationStatus        @default(TRIGGERED)
  triggerReason        String
  triggerEvidence      Json                    // Structured evidence from actual system
  decisionExplanation  String                  // Structured explanation text
  safetyEvaluation     Json                    // Results of safety checks
  actionTaken          ActuatorAction
  expectedOutcome      String
  observedOutcome      String?
  baselineMetricValue  Float
  targetMetricValue    Float
  finalMetricValue     Float?
  metricDelta          Float?
  verificationStatus   VerificationStatus      @default(PENDING)
  commandLatencyMs     Float?
  verificationLatencyMs Float?
  isEffective          Boolean?
  manualOverride       Boolean                 @default(false)
  startedAt            DateTime                @default(now())
  verifiedAt           DateTime?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([homeId, status, createdAt(sort: Desc)])
  @@index([policyId, createdAt(sort: Desc)])
}

model SystemEvent {
  id            String              @id @default(cuid())
  homeId        String
  home          Home                @relation(fields: [homeId], references: [id], onDelete: Cascade)
  timestamp     DateTime            @default(now())
  category      SystemEventCategory
  eventType     String              // e.g. "TELEMETRY_INGESTED", "VALIDATION_FAILED", "ANOMALY_DETECTED", "COMMAND_DISPATCHED"
  severity      SeverityLevel       @default(INFO)
  source        String              // e.g. "TELEMETRY_PIPELINE", "AUTOMATION_ENGINE"
  entityType    String              // "DEVICE", "SENSOR", "INCIDENT", "PREDICTIVE_INCIDENT", "POLICY", "COMMAND", "SYSTEM"
  entityId      String?
  summary       String
  metadata      Json?
  correlationId String?

  @@index([homeId, timestamp(sort: Desc)])
  @@index([homeId, category, timestamp(sort: Desc)])
  @@index([homeId, severity, timestamp(sort: Desc)])
  @@index([correlationId])
}




